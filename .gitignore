# ============= Python 核心 =============
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/
*.log

# ============= 环境变量与密钥（生死攸关！） =============
.env
.env.local
.env.*.local

# ============= 数据库与备份（坚决不上传） =============
*.db
*.sql
*.sql.gz
*.dump
*.bak

# ============= 项目运行时产生的文件 =============
uploads/
.run-logs/
*.stderr.log
*.stdout.log
tmp_*.json
tmp_*.txt
yecai.db
startup.log
# 目录里两个名称错误的文件（.gitignore 的模式行不支持行尾注释，注释必须独占一行）
ystemctl status nginx
frontend/ystemctl status mysqld

# ============= 前端 Node =============
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.local
*.log

# ============= IDE / 操作系统 =============
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
Desktop.ini
.DS_Store

# ============= 旧系统数据（明文客户资料，坚决不上传） =============
old_data/export/
old_data/*.bak
old_data/*.sql
old_data/**/*.csv
old_data/**/*.json
# 例外：导出/诊断脚本本身不含数据，要进版本控制
!old_data/export_from_sqlserver.sql
!old_data/export_from_sqlserver.bat
!old_data/inspect_export.py
